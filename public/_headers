# Header Cloudflare Pages. Ikut ter-copy ke dist/ saat build.
# Semua aturan yang cocok digabung (bukan saling menimpa).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Aset ber-hash: aman di-cache selamanya
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Aset stabil yang namanya bisa berubah isi: cache 7 hari
/logo/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800

/og.jpg
  Cache-Control: public, max-age=604800

# Dashboard internal: jangan masuk indeks meski tautannya bocor
/dashboard/*
  X-Robots-Tag: noindex, nofollow
