---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import SpecList from '../components/SpecList.astro';
import SizeTable from '../components/SizeTable.astro';
import { SITE, hasShopee, contactLink } from '../config/site';

import { base } from '../config/base';

const specs = [
  { label: 'Bahan', value: '100% Cotton Combed 24s–30s' },
  { label: 'Potongan', value: 'Regular fit' },
  { label: 'Warna', value: 'Jet Black' },
  { label: 'Sablon', value: 'DTF premium, finishing doff' },
  { label: 'Detail', value: 'Inside neck print, hangtag doff' },
  { label: 'Harga', value: SITE.priceLabel },
];

const steps = [
  {
    n: '01',
    title: 'Pesan',
    body: 'Pilih ukuran di Shopee. Bayar. Pesanan masuk ke antrean cetak.',
  },
  {
    n: '02',
    title: 'Cetak',
    body: 'Kaos dicetak satu per satu. 1–2 hari kerja.',
  },
  {
    n: '03',
    title: 'Kirim',
    body: 'Dikemas, dikirim. Nomor resi muncul di Shopee.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: SITE.product,
  brand: { '@type': 'Brand', name: SITE.name },
  description:
    'Kaos katun combed 24s–30s, regular fit, Jet Black. Sablon DTF premium finishing doff.',
  material: '100% Cotton Combed 24s–30s',
  color: 'Jet Black',
  offers: {
    '@type': 'Offer',
    price: String(SITE.price),
    priceCurrency: 'IDR',
    availability: 'https://schema.org/MadeToOrder',
    url: SITE.shopeeProductUrl || undefined,
  },
};
---

<Base
  title="BSNG. — MAXIMUM NOISE. | Chapter 01: The Core Anthem"
  description="Seragam pergerakan dari BSNG. The Core Anthem: combed 24s–30s, regular fit, sablon DTF doff. Rp159.000. Made to order, dicetak di Indonesia."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="label">Chapter {SITE.chapter} — {SITE.product}</p>

      <h1 class="hero__mark">
        <Wordmark fluid />
      </h1>

      <p class="hero__tagline label">{SITE.tagline}</p>

      <div class="hero__body">
        <p class="lead">Seragam pergerakan untuk yang bicara tanpa berteriak.</p>
        <p class="hero__meta label">
          Combed 24s–30s · Regular fit · Jet Black · {SITE.priceLabel}
        </p>
      </div>

      <div class="hero__actions">
        {
          hasShopee ? (
            <Button href={SITE.shopeeProductUrl} variant="primary" external>
              Beli di Shopee
            </Button>
          ) : (
            <Button variant="ghost">Segera dibuka.</Button>
          )
        }
        <Button href={`${base}chapter01/`} variant="ghost">Spesifikasi lengkap</Button>
      </div>
    </div>
  </section>

  <Section index="01" label="Objek" id="objek">
    <div class="grid-2">
      <div>
        <h2>Kaos berat. Potongan lurus. Satu warna.</h2>
        <p class="mt">
          The Core Anthem dibuat dari katun combed 24s–30s. Cukup tebal untuk jatuh dengan
          benar, cukup dingin untuk dipakai seharian di iklim ini.
        </p>
        <p>
          Logo dicetak besar di dada dengan tekstur noise, supaya sablon DTF tidak jadi bidang
          kaku yang menempel di kulit. Di punggung, satu baris kecil: MAXIMUM NOISE.
        </p>
        <p class="mt">
          <a class="inline-link" href={`${base}chapter01/`}>Spesifikasi lengkap →</a>
        </p>
      </div>

      <SpecList items={specs} />
    </div>
  </Section>

  <Section index="02" label="Posisi" id="posisi">
    <div class="statement">
      <h2>Bising bukan soal volume.</h2>
      <div class="statement__body">
        <p>Semua orang bicara. Sedikit yang mengatakan sesuatu.</p>
        <p>
          BSNG. dibuat untuk yang terakhir itu: yang memilih berpikir sebelum bicara, dan tetap
          bicara setelahnya.
        </p>
        <p class="mt">
          <a class="inline-link" href={`${base}manifesto/`}>Baca manifesto →</a>
        </p>
      </div>
    </div>
  </Section>

  <Section index="03" label="Cara kerja" id="cara-kerja">
    <h2>Dicetak setelah kamu pesan.</h2>
    <p class="mt">
      Tidak ada stok yang menunggu di gudang. Tidak ada sisa yang dibuang.
    </p>

    <ol class="steps">
      {
        steps.map((step) => (
          <li class="step">
            <span class="step__n label">{step.n}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section index="04" label="Ukuran" id="ukuran-ringkas">
    <h2>Diukur dari kaos jadi.</h2>
    <p class="mt">Lebar dada × panjang badan. Toleransi jahit 1–2 cm.</p>
    <div class="mt-lg">
      <SizeTable />
    </div>
    <p class="mt">
      <a class="inline-link" href={`${base}chapter01/#ukuran`}>Tabel ukuran lengkap →</a>
    </p>
  </Section>

  <section class="closing">
    <div class="wrap">
      <h2>Chapter {SITE.chapter} tersedia.</h2>
      <p class="mt">Satu produk. Satu warna. Satu pesan.</p>
      <div class="hero__actions">
        {
          hasShopee ? (
            <Button href={SITE.shopeeProductUrl} variant="primary" external>
              Beli di Shopee
            </Button>
          ) : (
            <Button variant="ghost">Segera dibuka.</Button>
          )
        }
        <Button
          href={contactLink}
          variant="ghost"
          external
        >
          Tanya ukuran di DM Instagram
        </Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(40px, 5vw, 56px) var(--section-y);
  }

  /* Wordmark dibatasi tinggi viewport: rasio 2.345:1 */
  .hero__mark {
    margin-top: clamp(16px, 2vw, 28px);
    line-height: 0;
    max-width: min(100%, calc(clamp(240px, 46vh, 480px) * 2.345));
  }

  .hero__tagline {
    margin-top: var(--s4);
    font-size: 12px;
    letter-spacing: 0.42em;
    color: var(--grey);
  }

  .hero__body {
    margin-top: var(--s6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s5);
    align-items: flex-end;
    justify-content: space-between;
  }

  .hero__meta {
    color: var(--grey);
  }

  .hero__body .lead {
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s5);
  }

  /* Anton display: hindari baris terakhir berisi satu kata (lihat docs/04-desain.md) */
  .grid-2 h2,
  .statement h2 {
    text-wrap: balance;
    max-width: 24ch;
  }

  /* Laptop pendek (1366×768 dan sejenisnya): rapatkan hero agar CTA tetap di atas lipatan */
  @media (min-width: 960px) and (max-height: 820px) {
    .hero {
      padding-block: 32px var(--s7);
    }

    .hero__mark {
      margin-top: 14px;
      max-width: min(100%, calc(clamp(200px, 40vh, 480px) * 2.345));
    }

    .hero__body {
      margin-top: var(--s5);
    }
  }


  .grid-2 {
    display: grid;
    gap: var(--s7);
    align-items: start;
  }

  .grid-2 h2 {
    margin-bottom: var(--s5);
  }

  .mt {
    margin-top: var(--s5);
  }

  .mt-lg {
    margin-top: var(--s6);
  }

  .statement {
    display: grid;
    gap: var(--s6);
    align-items: start;
  }

  .statement__body {
    max-width: 52ch;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: var(--s7) 0 0;
    display: grid;
    gap: var(--s6);
    border-top: 1px solid var(--hairline);
  }

  .step {
    padding-top: var(--s5);
  }

  .step__n {
    color: var(--grey);
  }

  .step__title {
    margin-top: var(--s3);
  }

  .step__body {
    margin-top: var(--s2);
    font-size: 15px;
    color: var(--grey);
  }

  .closing {
    border-top: 1px solid var(--hairline);
    padding-block: var(--section-y);
    background: var(--ink);
  }

  @media (min-width: 640px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      border-top: 0;
      gap: var(--s6);
    }

    .step {
      border-top: 1px solid var(--hairline);
    }
  }

  @media (min-width: 960px) {
    .grid-2 {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--s8);
    }

    .statement {
      grid-template-columns: 1fr 1fr;
      gap: var(--s8);
    }
  }
</style>
