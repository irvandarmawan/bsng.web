---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'ghost-dark';
  size?: 'md' | 'sm';
  external?: boolean;
  type?: 'button';
}

const { href, variant = 'ghost', size = 'md', external = false } = Astro.props;

// Tombol tanpa tujuan tidak dirender sebagai link mati.
const isDead = href === undefined || href === '';
const cls = `btn btn--${variant} btn--${size}`;
---

{
  isDead ? (
    <span class={`${cls} btn--disabled`} aria-disabled="true">
      <slot />
    </span>
  ) : (
    <a
      class={cls}
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      <slot />
    </a>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 0 32px;
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1px solid transparent;
    transition:
      background-color 120ms ease-out,
      border-color 120ms ease-out,
      color 120ms ease-out;
    cursor: pointer;
  }

  .btn--sm {
    height: 40px;
    padding: 0 20px;
  }

  .btn--primary {
    background: var(--red);
    color: var(--paper);
  }

  .btn--primary:hover {
    background: var(--red-dark);
  }

  .btn--ghost {
    border-color: var(--hairline);
    color: var(--paper);
  }

  .btn--ghost:hover {
    border-color: var(--paper);
  }

  .btn--ghost-dark {
    border-color: var(--hairline-dark);
    color: var(--ink);
  }

  .btn--ghost-dark:hover {
    border-color: var(--ink);
  }

  .btn--disabled {
    border-color: var(--hairline);
    color: var(--grey);
    cursor: not-allowed;
  }

  @media (max-width: 639px) {
    .btn {
      width: 100%;
    }
  }
</style>
