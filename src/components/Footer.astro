---
import Wordmark from './Wordmark.astro';
import { SITE } from '../config/site';

const year = new Date().getFullYear();

const socials = [
  { label: 'Instagram', href: SITE.social.instagram },
  { label: 'TikTok', href: SITE.social.tiktok },
  { label: 'X', href: SITE.social.x },
];
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <div class="foot__brand">
        <Wordmark height={28} />
        <p class="label foot__tagline">{SITE.tagline}</p>
      </div>

      <ul class="foot__social">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
                <span class="foot__handle">@bsng.co</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="foot__bottom">
      <p class="label">Made to order. Dicetak di Indonesia.</p>
      <p class="label">© {year} BSNG.</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--hairline);
    padding-block: var(--s7) var(--s6);
  }

  .foot__top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s6);
    justify-content: space-between;
    align-items: flex-start;
  }

  .foot__tagline {
    margin-top: var(--s4);
    letter-spacing: 0.42em;
  }

  .foot__social {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s2);
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .foot__social a {
    color: var(--grey);
  }

  .foot__social a:hover {
    color: var(--paper);
  }

  .foot__social a {
    display: inline-block;
    padding-block: 10px;
    margin-block: -10px;
  }

  .foot__handle {
    margin-inline-start: 12px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--grey);
  }

  .foot__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    justify-content: space-between;
    margin-top: var(--s7);
    padding-top: var(--s5);
    border-top: 1px solid var(--hairline);
  }
</style>
