{
  // Project ini dibuat di Cloudflare sebagai Worker (bukan Pages), jadi
  // situs statis disajikan lewat Workers Static Assets dari ./dist.
  "name": "bsng-web",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
